<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="ongkir"/>
        <attribute name="authors" value="Hasbi"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-11 09:49:56 PM"/>
        <attribute name="created" value="SGFzYmk7U0hJUk9ORUtPOzIwMjYtMDktMTA7MTI6MjQ6MzMgUE07MjQ1Ng=="/>
        <attribute name="edited" value="SGFzYmk7U0hJUk9ORUtPOzIwMjYtMDktMTE7MDk6NDk6NTYgUE07NDsyNTg2"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="ongkir, ttlbelanja, brtblt" type="Integer" array="False" size=""/>
            <declare name="berat" type="Real" array="False" size=""/>
            <declare name="tujuan" type="String" array="False" size=""/>
            <output expression="&quot;masukan total belanja&quot;" newline="True"/>
            <input variable="ttlbelanja"/>
            <output expression="&quot;masukan total berat barang&quot;" newline="True"/>
            <input variable="berat"/>
            <output expression="&quot;tujuan dalam pulau jawa (y/n)?&quot;" newline="True"/>
            <input variable="tujuan"/>
            <while expression="berat &lt;0">
                <output expression="&quot;berat tidak boleh kurang dari 0&quot;" newline="True"/>
                <input variable="berat"/>
            </while>
            <if expression="berat&gt;Int(berat)">
                <then>
                    <assign variable="brtblt" expression="Int(berat)+1"/>
                </then>
                <else>
                    <assign variable="brtblt" expression="Int(berat)"/>
                </else>
            </if>
            <if expression="ttlbelanja&gt;=200000">
                <then>
                    <if expression="brtblt&gt;3">
                        <then>
                            <assign variable="ongkir" expression="(brtblt-3)*5000"/>
                        </then>
                        <else>
                            <assign variable="ongkir" expression="0"/>
                        </else>
                    </if>
                </then>
                <else>
                    <assign variable="ongkir" expression="brtblt*4000"/>
                </else>
            </if>
            <if expression="tujuan=&quot;y&quot;">
                <then>
                    <assign variable="ongkir" expression="ongkir"/>
                </then>
                <else>
                    <assign variable="ongkir" expression="ongkir+15000"/>
                </else>
            </if>
            <output expression="&quot;ongkir= &quot;&amp; ongkir" newline="True"/>
        </body>
    </function>
</flowgorithm>
