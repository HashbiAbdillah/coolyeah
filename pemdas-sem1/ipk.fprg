<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="ipk"/>
        <attribute name="authors" value="Hasbi"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-12 04:49:26 PM"/>
        <attribute name="created" value="SGFzYmk7U0hJUk9ORUtPOzIwMjYtMDktMTA7MDU6Mjg6MTQgUE07MjQ2MQ=="/>
        <attribute name="edited" value="SGFzYmk7U0hJUk9ORUtPOzIwMjYtMDktMTI7MDQ6NDk6MjYgUE07MzsyNTc4"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="ipk" type="Real" array="False" size=""/>
            <declare name="semester" type="Integer" array="False" size=""/>
            <output expression="&quot;semester: &quot;" newline="True"/>
            <input variable="semester"/>
            <while expression="semester&gt;14||semester&lt;1">
                <output expression="&quot;semester tidak valid&quot;" newline="True"/>
                <input variable="semester"/>
            </while>
            <while expression="semester&lt;2">
                <output expression="&quot;mahasiswa semester 1 tidak boleh mengambil mata kuliah pilihan&quot;" newline="True"/>
                <input variable="semester"/>
            </while>
            <output expression="&quot;IPK:&quot;" newline="True"/>
            <input variable="ipk"/>
            <while expression="ipk&gt;4||ipk&lt;=0">
                <output expression="&quot;ipk tidak valid&quot;" newline="True"/>
                <input variable="ipk"/>
            </while>
            <if expression="ipk&lt;=2.99">
                <then>
                    <if expression="ipk&gt;=2.50">
                        <then>
                            <output expression="&quot;maksimal 21 SKS.&quot;" newline="True"/>
                        </then>
                        <else>
                            <if expression="ipk&gt;=2">
                                <then>
                                    <output expression="&quot;maksimal 18 SKS&quot;" newline="True"/>
                                </then>
                                <else>
                                    <output expression="&quot;maksimal 15 SKS&quot;" newline="True"/>
                                </else>
                            </if>
                        </else>
                    </if>
                </then>
                <else>
                    <output expression="&quot;Maksimal 24 sks&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
